{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YMB EJS差分同期ツール",
  "version": "1.2.4",
  "identifier": "com.ymb.ejs-html-sync",
  "build": {
    "beforeBuildCommand": "node scripts/vendor.mjs",
    "beforeDevCommand": "node scripts/vendor.mjs",
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YMB EJS差分同期ツール",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#f5f6f8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src http://ymbsandbox.localhost ymbsandbox:; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Japanese"],
        "displayLanguageSelector": false
      }
    }
  }
}
